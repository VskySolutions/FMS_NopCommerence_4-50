@* Confirmation dialog box for delete *@
<div id="custom-delete-dialog" class="dialog hidden">
    <div class="dialog-content">
        <div class="dialog-header">
            <h3>Are you sure?</h3>
            <button class="close-dialog" id="close-dialog">×</button>
        </div>
        <div class="dialog-body">
            <p>Are you sure you want to delete this estimate?</p>
        </div>
        <div class="dialog-footer">
            <button id="confirm-delete" class="btn btn-primary">Yes</button>
            <button id="cancel-delete" class="btn btn-secondary">No, cancel</button>
        </div>
    </div>
</div>
<style>
    /* Dialog container */
    .dialog {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    /* Dialog box */
    .dialog-content {
        background: #fff;
        width: 400px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        animation: fadeIn 0.3s;
    }

    /* Dialog header */
    .dialog-header {
        padding: 16px;
        background: #f5f5f5;
        border-bottom: 1px solid #ddd;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .dialog-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: bold;
        }

    .close-dialog {
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
    }

    /* Dialog body */
    .dialog-body {
        padding: 16px;
        font-size: 16px;
        color: #555;
    }

    /* Dialog footer */
    .dialog-footer {
        padding: 16px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        background: #f5f5f5;
        border-top: 1px solid #ddd;
    }

    /* Buttons */
    .btn {
        padding: 8px 16px;
        font-size: 14px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: background 0.3s;
    }

    .btn-primary {
        background: #007bff;
        color: #fff;
    }

        .btn-primary:hover {
            background: #0056b3;
        }

    .btn-secondary {
        background: #e0e0e0;
        color: #333;
    }

        .btn-secondary:hover {
            background: #c0c0c0;
        }

    /* Hide dialog */
    .hidden {
        display: none;
    }

    /* Fade-in animation */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

</style>
