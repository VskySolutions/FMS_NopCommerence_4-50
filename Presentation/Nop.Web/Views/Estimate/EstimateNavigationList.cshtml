@model EstimateDetailsModel
@using Nop.Web.Models.Estimate;

<div class="estimate-full-page">
    <div class="page-title-new">
        <h1 style="display:inline-block;">My Estimate List</h1>

        <input id="SeName" name="SeName" value="@Model.SeName" style="display:none" />
        @if (Model.IsCustomer)
        {
            <a href="@Url.RouteUrl("NewEstimate")" style="float: right;" class="estimate-btn">
                <i class="fas fa-plus-square"></i>Add Estimate
            </a>
        }
    </div>
    @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.AccountNavigationBefore, additionalData = Model })

    @if (Model.NavBar.Count() > 0)
    {
        <table class="estimate-table">
            <thead>
                <tr>
                    <th>Estimate Id</th>
                    @if (!String.IsNullOrEmpty(Model.UserRole) && Model.UserRole.Equals("Admin"))
                    {
                        <th style="width:25%;">Estimate Name</th>
                        <th style="width:30%;">Description</th>
                        <th>Created On</th>
                        <th>Created For</th>
                    }
                    else
                    {
                        <th style="width:30%;">Estimate Name</th>
                        <th style="width:35%;">Description</th>
                        <th>Created On</th>
                    }
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.NavBar)
                {
                    <tr>
                        <td>@item.ListId</td>
                        <td>
                            @* <a href="@Url.RouteUrl("goestimate", new { Estimateid = item.ListId })">
                    @item.Name
                    </a> *@
                            @item.Name
                        </td>
                        <td>@item.Description</td>
                        <td>@item.CreatedOn</td>
                        @if (!String.IsNullOrEmpty(Model.UserRole) && Model.UserRole.Equals("Admin"))
                        {
                            <td>@item.CratedbyStr</td>
                        }
                        <td>
                            @* @if (item.IsEstimateItems)
                    {
                    <a href="@Url.RouteUrl("goestimate", new { Estimateid = item.ListId, isView = true })" data-toggle="tooltip" title="View Estimate">
                    <span style="color:#555555;font:bold;" class="fa fa-eye"></span>
                    </a>
                    } *@
                            <a href="@Url.RouteUrl("goestimate", new { Estimateid = item.ListId, isView = false })" data-toggle="tooltip" title="Edit Estimate">
                                <span style="color:#555555;font:bold;" class="fas fa-edit"></span>
                            </a>
                            @if (item.IsEstimateItems)
                            {
                                <a href="#" id="LinkCopyEstimate" data-estimateid="@item.ListId" data-toggle="tooltip" title="Copy Estimate">
                                    <span style="color:#555555;font:bold;" class="fa fa-copy"></span>
                                </a>
                            }
                            <a href="#" id="DeleteEstimate" data-estimateid="@item.ListId" data-toggle="tooltip" title="Delete Estimate">
                                <span style="color:#555555;font:bold;" class="fas fa-trash-alt"></span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            @foreach (var item in Model.NavBar)
            {
                <div class="modal fade" id="CopyPop_@item.ListId" tabindex="-1" role="dialog" aria-labelledby="modalLabel_@item.ListId" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title" id="#">All items will be copied into new estimate!</h4>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="form-group" style="padding-bottom:10px;">
                                    <label for="CopyName_@item.ListId">Estimate Name:</label>
                                    <input type="text" id="CopyName_@item.ListId" class="form-control" required />
                                </div>
                                @if (!String.IsNullOrEmpty(Model.UserRole) && Model.UserRole.Equals("Admin"))
                                {
                                    <div class="form-group" style="min-width: 200px;padding-bottom:10px;">
                                        <label style="padding-right:37px;">Customer:</label>
                                        @Html.DropDownListFor(m => m.CreatedBy, Model.CustomerList, new { @class = "form-control", @id = "CreatedBy_" + item.ListId })
                                    </div>
                                }
                                <div class="form-group">
                                    <label for="CopyDescriptions_@item.ListId" style="padding-right:26px;">Description:</label>
                                    <textarea id="CopyDescriptions_@item.ListId" class="form-control"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-primary btnAddCopyEstimate" data-estimateid="@item.ListId">
                                    Copy Estimate
                                </button>
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </table>
    }
    else
    {
        <table class="estimate-table">
            <thead>
                <tr>
                    <th>Estimate Id</th>
                    @if (!String.IsNullOrEmpty(Model.UserRole) && Model.UserRole.Equals("Admin"))
                    {
                        <th style="width:25%;">Estimate Name</th>
                        <th style="width:30%;">Description</th>
                        <th>Created On</th>
                        <th>Created For</th>
                    }
                    else
                    {
                        <th style="width:30%;">Estimate Name</th>
                        <th style="width:35%;">Description</th>
                        <th>Created On</th>
                    }
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="8">
                        <span style="color:#f10a0a;">No Estimates are available.</span>
                    </td>
                </tr>
            </tbody>
        </table>
    }
</div>

<script type="text/javascript">
    $(document).on('click', '.btnAddCopyEstimate', function () {
        var estimateId = $(this).data('estimateid');
        var name = $("#CopyName_" + estimateId).val();
        var description = $("#CopyDescriptions_" + estimateId).val();
        var customerId = $("#CreatedBy_" + estimateId).val();

        //console.log("Estimate ID:", estimateId, "Name:", name, "Description:", description, "CustomerId", customerId);

        // Construct the URL
        var URL = "/Estimate/CopyEstimate?EstimateId=" + estimateId + "&Name=" + name + "&Description=" + description + "&CustomerId=" + customerId;

        // Perform the AJAX request
        $.ajax({
            type: 'POST',
            url: URL,
            contentType: 'application/json; charset=utf-8',
            dataType: "json",
            success: function (data) {
                if (data.ErrorMsg) {
                    displayBarNotification(data.ErrorMsg, 'error', 0);
                } else {
                    $(".modal").modal('hide');
                    location.reload(true); // Refresh the page
                    displayBarNotification('Copied Estimate Successfully...', 'success', 3500);
                }
            }
        });
    });

    $(document).on('click', '#DeleteEstimate', function (e) {
        e.preventDefault();

        var estimateId = $(this).data('estimateid');
        var deleteUrl = "/Estimate/DeleteEstimate";

        // Show the dialog
        $('#custom-delete-dialog').removeClass('hidden');

        // Handle Confirm button click
        $('#confirm-delete').off('click').on('click', function () {
            $('#custom-delete-dialog').addClass('hidden'); // Hide the dialog

            // Perform the delete operation
            $.ajax({
                type: "POST",
                url: deleteUrl,
                data: { EstimateId: estimateId },
                success: function (response) {
                    location.reload();
                    displayBarNotification('Deleted Estimate Successfully.');
                },
                error: function (xhr, status, error) {
                    alert("An error occurred while deleting the estimate: " + error);
                }
            });
        });

        // Handle Cancel button click or Close button
        $('#cancel-delete, #close-dialog').off('click').on('click', function () {
            $('#custom-delete-dialog').addClass('hidden'); // Simply hide the dialog
        });
    });

</script>
<script type="text/javascript">
    $(document).ready(function () {
        $(".close").click(function () {
            $(".modal.Prod").hide();
            $("body").css("overflow", "visible");

        })

        $(".cancelNo").click(function () {
            $(".modal.Prod").hide();
            $("body").css("overflow", "visible");
        })
    })
</script>

<style>
    .page-title-new {
        border-bottom: 2px solid #3266ae;
        min-height: 50px;
        margin: 0 0 20px;
    }

    .estimate-btn {
        display: flex;
        align-items: center;
        gap: 5px;
        transition: background-color 0.3s, transform 0.2s;
        color: white;
        padding: 10px 10px;
        background-color: #467e9f;
        border-radius: 5px;
    }

        .estimate-btn:hover {
            background-color: #0056b3;
            transform: scale(1.00);
        }
    /* Full-page container styles */
    .estimate-full-page {
        margin: 0 auto;
        /* padding: 20px; */
        max-width: 1200px;
    }

        .estimate-full-page .title {
            font-size: 24px;
            margin-bottom: 20px;
            text-align: center;
        }

    /* Table styling */
    .estimate-table {
        width: 100%;
        border-collapse: collapse;
        font-family: Arial, sans-serif;
        margin-top: 20px;
    }

        .estimate-table th, .estimate-table td {
            border: 1px solid #ddd;
            padding: 8px 5px;
            text-align: left;
            font-size: 14px;
        }

        .estimate-table thead {
            background-color: #f4f4f4;
        }

        .estimate-table th {
            font-weight: bold;
            color: #333;
        }

        .estimate-table tbody tr:nth-child(odd) {
            background-color: #f9f9f9;
        }

        .estimate-table tbody tr:hover {
            background-color: #f1f1f1;
        }

        .estimate-table td a {
            margin-right: 5px;
            text-decoration: none;
            color: #007bff;
        }

            .estimate-table td a:hover {
                color: #0056b3;
            }

        .estimate-table td i {
            font-size: 14px;
        }

        .estimate-table td {
            word-break: break-word;
            white-space: normal;
        }
</style>

<script>
    $(document).on('click', '#LinkCopyEstimate', function (e) {
        e.preventDefault();
        var estimateId = $(this).data('estimateid');
        $("#CopyPop_" + estimateId).modal('show');
    });
</script>

