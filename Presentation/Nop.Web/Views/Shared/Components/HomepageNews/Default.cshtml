@model HomepageNewsItemsModel
@if (Model.NewsItems.Count > 0)
{
    <div class="news-list-homepage">
        <div>
            <h2 style="text-align: left; background: #555; color: #fff; padding: 10px 10px;">@T("News")</h2>
        </div>
        <div class="news-items">
            @foreach (var item in Model.NewsItems)
            {
                <div class="news-item new-items home-news">
                    <div class="news-head">
                        <a class="news-title" href="@Url.RouteUrl("NewsItem", new { SeName = item.SeName })">@item.Title</a>
                        <span class="news-date">-@item.CreatedOn.ToString("D")</span>
                    </div>
                    <div class="news-body">
                        @Html.Raw(item.Short)
                    </div>
                    <div class="buttons">
                        <a href="@Url.RouteUrl("NewsItem", new { SeName = item.SeName })" class="read-more">@T("News.MoreInfo")</a>
                    </div>
                </div>
            }
        </div>
        <div class="view-all">
            <a class="ViewAllNews" href="@Url.RouteUrl("NewsArchive")">View All</a>
        </div>
    </div>
}
<style>
    .ViewAllNews {
        display: table;
        margin: auto;
        margin-top: 20px;
        padding: 10px 15px;
        background-color: #555555;
        border-radius: 10px;
        color: white !important;
    }
</style>