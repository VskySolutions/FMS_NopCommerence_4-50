@if (IsSectionDefined("Breadcrumb"))
{
    @section Breadcrumb {
        @RenderSection("Breadcrumb")
    }
}
<div class="side-2">
    @if (IsSectionDefined("left"))
    {
        @RenderSection("left")
    }
    else
    {
        @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.LeftSideColumnBefore, additionalData = Model }) 
        @Html.ActionLink("CategoryNavigation", "Catalog", new { currentCategoryId = currentCategoryId, currentProductId = currentProductId })
        @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.LeftSideColumnAfterCategoryNavigation, additionalData = Model }) 
        @*@Html.ActionLink("ManufacturerNavigation", "Catalog", new { currentManufacturerId = currentManufacturerId })*@
        @Html.ActionLink("VendorNavigation", "Catalog")
        @Html.ActionLink("RecentlyViewedProductsBlock", "Product", new { productThumbPictureSize = 64 })
        @Html.ActionLink("PopularProductTags", "Catalog")
        @Html.ActionLink("PollBlock", "Poll", new { systemKeyword = "LeftColumnPoll" })
        @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.LeftSideColumnAfter, additionalData = Model }) 
    }
</div>
<div class="center-2">
    @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.MainColumnBefore, additionalData = Model })    
    @RenderBody()
    @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.MainColumnAfter, additionalData = Model })    
</div>
