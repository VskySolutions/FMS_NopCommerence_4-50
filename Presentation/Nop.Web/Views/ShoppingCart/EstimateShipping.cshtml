@model EstimateShippingModel
@using Nop.Web.Models.ShoppingCart;
@if (Model.Enabled)
{
    <div class="shipping">
        <script type="text/javascript">
            $(document).ready(function () {
                $("#SidebarCountryId").change(function() {
                    var selectedItem = $(this).val();
                    var ddlStates = $("#SidebarStateProvinceId");
                    var estimateProgress = $("#estimate-shipping-loading-progress");

                    $("#SidebarZipPostalCode").val('');

                    estimateProgress.show();
                    $.ajax({
                        cache: false,
                        type: "GET",
                        url: "@(Url.Action("GetStatesByCountryId", "Country"))",
                        data: { "countryId": selectedItem, "addSelectStateItem": "false" },
                        success: function(data) {
                            ddlStates.html('');
                            $.each(data, function(id, option) {
                                ddlStates.append($('<option></option>').val(option.id).html(option.name));
                            });
                            estimateProgress.hide();
                        },
                        error: function(xhr, ajaxOptions, thrownError) {
                            alert('Failed to retrieve states.');
                            estimateProgress.hide();
                        }
                    });
                });

                $("#SidebarStateProvinceId").change(function() {
                    $("#SidebarZipPostalCode").val('');
                });
            });
        </script>

        <div class="estimate-shipping">
            <div class="title">
                <strong><label>Estimate shipping</label></strong>
            </div>
            <div class="hint"><label>Enter your destination to get a shipping estimate</label></div>
            <div class="shipping-options">
                <div class="inputs">
                    <label>Country</label>
                    @Html.DropDownListFor(model => model.CountryId, Model.AvailableCountries, new { @class = "country-input", id = "SidebarCountryId" })
                    <span class="required">*</span>
                </div>
                <div class="inputs">
                    <label>State / province:</label>
                    @Html.DropDownListFor(model => model.StateProvinceId, Model.AvailableStates, new { @class = "state-input", id = "SidebarStateProvinceId" })
                    <span id="estimate-shipping-loading-progress" style="display: none;" class="please-wait">@T("Common.Wait...")</span>
                </div>
                <div class="inputs">
                    <label>Zip / postal code:</label>
                    @Html.TextBoxFor(model => model.ZipPostalCode, new { @class = "zip-input", id = "SidebarZipPostalCode" })
                </div>
                <div class="buttons">
                    <input id="estimate-shipping-button" type="button" value="@T("ShoppingCart.EstimateShipping.Button")" class="button-2 estimate-shipping-button" />
                </div>
            </div>
            <div class="estimate-shipping-result"></div>
        </div>
    </div>
}
<script type="text/javascript">
    $(document).ready(function () {
        $('#estimate-shipping-button').click(function() {
            displayAjaxLoading(true);

            // 1. Find the popup's address fields
            var $popup = $('#estimate-shipping-popup');
            var popupFields = $popup.find('[name="CountryId"], [name="StateProvinceId"], [name="ZipPostalCode"]');

            // 2. Store their names and remove them so they won't serialize
            var originalNames = [];
            popupFields.each(function() {
                originalNames.push($(this).attr('name'));
                $(this).removeAttr('name');
            });

            var formData = $("#shopping-cart-form").serialize();

            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("GetEstimateShipping", "ShoppingCart"))",
                data: formData,
                success: function(data) {
                    displayAjaxLoading();

                    if (!data || data.trim() === '') {
                        $('.estimate-shipping-result').html('<div class="no-shipping-options">No shipping options available for this destination.</div>');
                    } else {
                        $('.estimate-shipping-result').html(data);
                    }
                },
                error: function(xhr, status, error) {
                    displayAjaxLoading();
                    alert('Failed to retrieve estimate shipping. Status: ' + xhr.status);
                },
                complete: function() {
                    // 3. Restore the names so the popup still works
                    popupFields.each(function(index) {
                        $(this).attr('name', originalNames[index]);
                    });
                }
            });
        });

        $("#SidebarZipPostalCode").keydown(function (event) {
            if (event.keyCode == 13) {
                $("#estimate-shipping-button").click();
                return false;
            }
        });
    });
</script>