@*Added by Yogesh Kumbhar on Dt: 01-28-2025 & 30-01-2025 & 01-31-2025
  Add multiple emails for customer*@
<div id="addemail-window" class="modal fade" data-backdrop="static" data-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="sendemail-window-title">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="sendemail-window-title">Add Email</h4>
                <button type="button" class="close" data-dismiss="modal" id="modalCloseButtonId" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <form id="emailForm" asp-controller="Customer" asp-action="InsertAndUpdateCustmerEmail" method="post">
                <input type="hidden" asp-for="Id" id="CustomerEmail_Id" />
                <div class="form-horizontal">
                    <div class="modal-body">
                        <div class="form-group row">
                            <div class="col-md-2">
                                <label for="CustomerEmail_Email" class="control-label">
                                    Email <span class="required">*</span>
                                </label>
                            </div>
                            <div class="col-md-9">
                                <input type="email" class="form-control text-box single-line"
                                       id="CustomerEmail_Email" name="CustomerEmail.Email" required />
                                <span class="field-validation-valid" data-valmsg-for="CustomerEmail.Email" data-valmsg-replace="true"></span>
                                <input type="hidden" id="emailId" name="CustomerEmail.Id" />
                            </div>
                        </div>
                        <div class="notification-section" style="margin-top:15px;">
                            <div class="section-title">
                                <strong>Set Notification Flags:</strong>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-3">
                                    <nop-editor asp-for="CustomerEmail.IsOrder" />
                                    <label for="orderFlag">Order Placement</label>
                                </div>
                                <div class="col-md-3">
                                    <nop-editor asp-for="CustomerEmail.IsOrderCancel" />
                                    <label for="invoiceFlag">Order Cancellation</label>
                                </div>
                                <div class="col-md-3">
                                    <nop-editor asp-for="CustomerEmail.IsEstimate" />
                                    <label for="estimateFlag">Estimate Added to Cart</label>
                                </div>
                                <div class="col-md-3">
                                    <nop-editor asp-for="CustomerEmail.IsRefund" />
                                    <label for="refundFlag">Order Refunded</label>
                                </div>
                                <div class="col-md-3">
                                    <nop-editor asp-for="CustomerEmail.IsOrderShipped" />
                                    <label for="refundFlag">Order Shipped</label>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="justify-content: center;margin-top: 10px;margin-bottom: 10px;">
                            <button type="submit" id="saveButton" class="btn btn-primary">Save</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@*Added by Yogesh Kumbhar on Dt: 01-28-2025 & 01-29-2025*@
<script>
    $(document).ready(function () {
        $('#addemail-window').modal({
            backdrop: 'static',
            keyboard: false,
            show: false  // This prevents auto-showing on page load
        });

        $('#modalCloseButtonId').click(function () {
            window.location.reload();
        });
        
        $(document).on('click', '.delete-email', function () {
            var button = $(this);
            var customerId = button.attr("data-id");
            var email = button.attr("data-email");
            var emailId = button.attr("data-emailid");

            //console.log("customerId = " + customerId + " email = " + email + " emailId = " + emailId);

            var URL = "/Admin/Customer/DeleteCustomerEmail?customerId=" + customerId + "&emailId=" + emailId;

            if (!confirm(`Are you sure you want to delete the email: ${email}?`)) {
                return;
            }

            $.ajax({
                url: URL,
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                //data: JSON.stringify({ customerId: customerId, emailId: emailId }),
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        button.closest('tr').remove();
                        window.location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert('An error occurred while trying to delete the email.');
                }
            });
        });

        $(document).on('click', function () {
            $('#delete-email').tooltip('hide');
        });

        //Added by Yogesh Kumbhar on Dt: 01-31-2025
        //Get email details.
        $(document).on('click', '.edit-email', function () {
            var index = $(this).data('id');

            $.ajax({
                url: "/Admin/Customer/GetCustomerEmail",
                type: "POST",
                data: { emailId: index },
                success: function (response) {
                    console.log(response);
                    if (response.success && response.response) {
                        var emailData = response.response;

                        console.log("Extracted Data:", emailData);

                        // Check if the elements exist before setting values
                        $('#emailId').val(emailData.Id);
                        $('#CustomerEmail_Email').val(emailData.Email);
                        $('#CustomerEmail_IsOrder').prop('checked', emailData.IsOrder);
                        $('#CustomerEmail_IsOrderCancel').prop('checked', emailData.IsOrderCancel);
                        $('#CustomerEmail_IsOrderShipped').prop('checked', emailData.IsOrderShipped);
                        $('#CustomerEmail_IsEstimate').prop('checked', emailData.IsEstimate);
                        $('#CustomerEmail_IsRefund').prop('checked', emailData.IsRefund);

                        $('#saveButton').text('Update');
                        $('#addemail-window').modal('show');
                    } else {
                        console.error("Invalid Response Data:", response);
                    }
                }
            });
        });

        // Handle modal reset when closed
        $(document).on('click', '#modalCloseButtonId', function () {
            resetModal();
        });

        function resetModal() {
            // Reset input fields
            $('#CustomerEmail_Email').val('');
            $('#emailId').val('');

            // Reset button text
            $('#saveButton').text('Save');
        }
    });
</script>
