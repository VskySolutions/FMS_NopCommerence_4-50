@using Nop.Web.Areas.Admin.Models.VideoGallaries
@model VideoGallaryModel

@Html.HiddenFor(model => model.Id)
@{
    //page title
    ViewBag.Title = "Edit VideoGallery";
}
<style>
    .AlignmentDelete {
        margin-left: 85%;
        margin-top: -60px;
    }
</style>
 <form sp-controller="VideoGallary" asp-action="Edit" id="VideoGalleryform" method="post">
     <input type="hidden" id="VideoID" name="custId" value=@Model.Id>
     <div style="margin-top:0; padding:15px;">
        <h3>Update Url </h3>
        <button type="button" name="deletevideo" class="btn bg-red AlignmentDelete">
            <i class="fa fa-trash-o"></i>
            @T("Admin.Common.Delete")
        </button>
    </div>
    <div class="panel-group content">
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="form-group" hidden>
                    <div class="col-md-3">
                        <label>Id:</label>
                    </div>
                    <div class="col-md-6">
                        <label>@Model.Id</label>
                    </div>
                 </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <label>Video title:</label>
                    </div>
                    <div class="col-md-6">
                        <input asp-for="VideoTitle" />
		                <span asp-validation-for="VideoTitle"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <label>VideoUrl:</label>
                    </div>
                    <div class="col-md-6">
                         <input asp-for="VideoUrl" />
		                <span asp-validation-for="VideoUrl"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <label>Publish:</label> 
                    </div>
                    <div class="col-md-6">
                        <input asp-for="Publish" />
		                <span asp-validation-for="Publish"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-9">
                        <button type="submit" name="save" class="btn bg-blue">
                            <i class="fa fa-floppy-o"></i>
                            @T("Admin.Common.Save")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
 </form>

  <script>
      $(document).ready(function() {
       //Delete video
       $('.AlignmentDelete').on('click', function () {
         var VideoID=$("#VideoID").val();
          addAntiForgeryToken(VideoID);
                $.ajax({
                type: 'post',
                url: '@Html.Raw(Url.Action("DeleteVideo", "VideoGallary", new {Id=@Model.Id}))',
                contentType: 'application/json; charset=utf-8',
                dataType: "json",
                success: function (data) {
                    alert("hii");
                    window.history.back();
                }
            });
        });
      });
 </script>





