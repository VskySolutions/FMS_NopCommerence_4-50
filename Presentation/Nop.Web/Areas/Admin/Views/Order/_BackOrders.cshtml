            @await Html.PartialAsync("Table", new DataTablesModel
            {
                Name = "BackOrder-grid",
                UrlRead = new DataUrl("BackOrderList", "Order",null),
                SearchButtonId = "BackOrder-List",
                Length = Model.PageSize,
                LengthMenu = Model.AvailablePageSizes,
                Filters = new List<FilterParameter>
                {
                    new FilterParameter(nameof(OrderModel.Id))
                },
                ColumnCollection = new List<ColumnProperty>
                    {
                    new ColumnProperty(nameof(OrderModel.Id))
                    {
                        IsMasterCheckBox = true,
                        Render = new RenderCheckBox("checkbox_orders"),
                        ClassName =  NopColumnClassDefaults.CenterAll,
                        Width = "50"
                    },
                    new ColumnProperty(nameof(OrderItemModel.ProductName))
                    {
                        Title = "Product Name",
                        Width = "100"
                    },
                    new ColumnProperty(nameof(OrderModel.ProductName))
                    {
                        Title = "Product Name",
                        Width = "100"
                    },
                    new ColumnProperty(nameof(OrderModel.Quantity))
                    {
                        Title = "Total Quantity",
                        Width = "50"
                    },
                    new ColumnProperty(nameof(OrderModel.BackOrderQty))
                    {
                        Title = "Back Order Quantity",
                        Width = "50"
                    },
                    new ColumnProperty(nameof(OrderModel.Sku))
                    {
                        Title = "Sku",
                        Width = "70"
                    },
                    new ColumnProperty(nameof(BackOrderModel.Id))
                    {
                        Title = "-",
                        Width = "50",
                        ClassName =  NopColumnClassDefaults.Button,
                        Render = new RenderButtonEdit(new DataUrl("Edit"))
                    }
                    }
            })


